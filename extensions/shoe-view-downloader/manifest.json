{
  "manifest_version": 3,
  "name": "鞋图四视图下载器",
  "version": "1.2.2",
  "description": "将网页鞋图拖入四格队列，直接复用标签页已加载图片生成预览，按鞋款、角度、序号和日期自动命名并保存高清原图。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开鞋图下载器"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
